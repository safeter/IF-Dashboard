# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe in the browser: the anon key is protected by the row
# level security policies in supabase/app_state.sql.
# NEVER put the service_role key or the database password in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
