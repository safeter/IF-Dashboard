@@ -0,0 +1,78 @@
+import { supabase } from "./supabase";
+
+/* ============================================================
+   Who may do what.
+
+   Roles live in the `members` table created by supabase/setup.sql:
+     admin   everything, plus managing access, restoring backups and
+             starting / renaming / deleting cycles
+     editor  add and change data, upload documents
+     viewer  read only
+
+   The database enforces these through row-level security; nothing here is
+   the lock, only the signage. This module just asks what the signed-in
+   person is allowed to do, so the screens can show the right controls.
+
+   "legacy" means the setup script has not been run yet (no members table).
+   The app then behaves exactly as it always has — everyone signed in can do
+   everything — so this code can be deployed before or after the script.
+   ============================================================ */
+export const ROLES = [
+  { id: "admin", label: "Admin", hint: "Everything, including who has access" },
+  { id: "editor", label: "Editor", hint: "Add and change data, upload documents" },
+  { id: "viewer", label: "Viewer", hint: "Read only" },
+];
+export const roleLabel = (id) => (ROLES.find((r) => r.id === id) || {}).label || "Full access";
+
+const missingTable = (error) =>
+  !!error && (error.code === "42P01" || error.code === "PGRST205" ||
+    /does not exist|schema cache|could not find the table/i.test(error.message || ""));
+
+/**
+ * The signed-in person's role.
+ * Resolves to { role } where role is admin | editor | viewer | legacy,
+ * { role: null } when they are signed in but not on the list, or
+ * { error } when the answer could not be fetched.
+ */
+export async function fetchRole(email) {
+  if (!supabase) return { role: "legacy" };
+  const { data, error } = await supabase
+    .from("members").select("role").eq("email", String(email || "").toLowerCase()).maybeSingle();
+  if (missingTable(error)) return { role: "legacy" };
+  if (error) return { error: error.message };
+  return { role: data ? data.role : null };
+}
+
+export async function listMembers() {
+  const { data, error } = await supabase.from("members").select("email, role, name, added_at, added_by").order("email");
+  return { data: data || [], error: error && error.message };
+}
+
+/** Accounts that exist but are not on the list. Admins only; empty for anyone else. */
+export async function listPendingAccounts() {
+  const { data, error } = await supabase.rpc("ifm_pending_accounts");
+  return { data: data || [], error: error && error.message };
+}
+
+const friendly = (error) => {
+  if (!error) return null;
+  const m = error.message || String(error);
+  if (/at least one admin/i.test(m)) return "There must always be at least one admin. Make someone else an admin first.";
+  if (/duplicate key|already exists/i.test(m)) return "That person already has access.";
+  if (/members_email_check/i.test(m)) return "That doesn't look like an email address.";
+  if (/row-level security|permission denied/i.test(m)) return "Only admins can change who has access.";
+  return m;
+};
+
+export async function addMember(email, role) {
+  const { error } = await supabase.from("members").insert({ email: String(email).trim().toLowerCase(), role });
+  return friendly(error);
+}
+export async function setMemberRole(email, role) {
+  const { error } = await supabase.from("members").update({ role }).eq("email", email);
+  return friendly(error);
+}
+export async function removeMember(email) {
+  const { error } = await supabase.from("members").delete().eq("email", email);
+  return friendly(error);
+}
